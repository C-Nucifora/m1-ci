#!/usr/bin/env bash
# pre-commit hook: keep M1 Build's per-save noise out of commits, and make any
# real toolchain change a deliberate, reviewed decision.
#
# Two categories, treated differently on purpose:
#
#   NORMALISED (rewritten, then the commit stops so you review and re-stage)
#     Project@BuildNumber        - increments on every build; the M1 Build
#                                  manual calls it the revision counter.
#     Project@VersionMajor/Minor - project identity; policy is 1.00.
#     *@Locale                   - the building machine's language setting.
#
#   ASSERTED (never rewritten; a mismatch stops the commit and asks for a pin
#             bump)
#     MoTeCM1BuildSession@ProductVersion - which M1 Build wrote the file
#     Project@FileFormat                 - the file's actual serialisation
#     System@*                           - the selected firmware package
#
# The split matters. Those three are FACTS about the toolchain that produced
# the file, not noise, and rewriting them fabricates history: forcing
# FileFormat backwards labels a converted file as the old format, and forcing
# ProductVersion backwards yields a file claiming M1 Build 1.4.4.981 wrote a
# 10109-format project, which it cannot have. Rewriting System@ silently
# reverts a deliberate firmware-package change - the exact bug in the retired
# Python hook this replaces. Asserting all three means the pins and the files
# can never disagree, so an impossible combination cannot be committed.
#
# Pins live in the consumer's m1-tools.toml, which CI asserts by running this
# same hook:
#
#     [project-baseline]
#     product_version = "1.4.5.556"                # asserted
#     file_format     = "10109"                    # asserted
#     locale          = "English_Australia.1252"   # normalised; optional
#
#     [project-baseline.system]                    # asserted; per repo
#     VersionBuild = "0108"
#
# product_version and file_format move together - a newer M1 Build changes
# both - so bump them in the same commit that lands the converted file.
# No [project-baseline] section is a clean no-op.
#
# It never runs `git add`: the retired hook staged its own edits, which could
# clobber a partial stage.
set -euo pipefail

config="m1-tools.toml"
[ -f "$config" ] || exit 0
grep -q '^\[project-baseline\]' "$config" || exit 0

value_of() {
  sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$config" | head -n1
}

product_version="$(value_of product_version)"
file_format="$(value_of file_format)"
locale="$(value_of locale)"
: "${locale:=English_Australia.1252}"

if [ -z "$product_version" ] || [ -z "$file_format" ]; then
  echo "m1-project-normalize: [project-baseline] needs product_version and file_format" >&2
  exit 2
fi

# Read one attribute from a given element. The <Project> element carrying
# FileFormat is the project header; revision-history entries such as
# <Project Name="AV24" Build="9"> and <File BuildNumber=...> must never match,
# which is what the lookahead excludes.
attr_of() { # <file> <element> <attribute>
  case "$2" in
    Project) perl -0777 -ne 'print $1 if /<Project\b(?=[^>]*?FileFormat=)[^>]*?'"$3"'="([^"]*)"/' "$1" ;;
    *)       perl -0777 -ne 'print $1 if /<'"$2"'\b[^>]*?'"$3"'="([^"]*)"/' "$1" ;;
  esac
}

# ---- pass 1: assert the toolchain facts, rewriting nothing -----------------
drift=""
note() { drift="$drift
    $1"; }

for file in "$@"; do
  [ -f "$file" ] || continue

  found="$(attr_of "$file" MoTeCM1BuildSession ProductVersion)"
  if [ -n "$found" ] && [ "$found" != "$product_version" ]; then
    note "$file: ProductVersion=$found, pinned $product_version"
  fi

  found="$(attr_of "$file" Project FileFormat)"
  if [ -n "$found" ] && [ "$found" != "$file_format" ]; then
    note "$file: FileFormat=$found, pinned $file_format"
  fi

  while IFS= read -r line; do
    key="${line%%=*}"; key="${key//[[:space:]]/}"
    val="${line#*=}"; val="${val#*\"}"; val="${val%%\"*}"
    [ -n "$key" ] && [ -n "$val" ] || continue
    found="$(attr_of "$file" System "$key")"
    if [ -n "$found" ] && [ "$found" != "$val" ]; then
      note "$file: System@$key=$found, pinned $val"
    fi
  done < <(sed -n '/^\[project-baseline\.system\]/,/^\[/{/^\[/d; /^[[:space:]]*#/d; /=/p;}' "$config")
done

if [ -n "$drift" ]; then
  echo "The toolchain that wrote these files differs from the pinned baseline:$drift"
  echo
  echo "These are facts about the M1 Build / firmware that produced the file, so"
  echo "they are reported rather than rewritten - relabelling would describe the"
  echo "file as something it is not. Nothing has been modified."
  echo
  echo "If the change is intended (an M1 Build upgrade, or a deliberate firmware"
  echo "selection), update [project-baseline] in m1-tools.toml to match, in the"
  echo "same commit that lands these files. product_version and file_format move"
  echo "together. If it is NOT intended, the file was saved by the wrong M1 Build"
  echo "- reopen and save it with the pinned version instead."
  exit 1
fi

# ---- pass 2: normalise the per-save noise ---------------------------------
prog='
  s{<Project\b(?=[^>]*?FileFormat=)[^>]*?VersionMajor="\K[^"]*}{1};
  s{<Project\b(?=[^>]*?FileFormat=)[^>]*?VersionMinor="\K[^"]*}{0};
  s{<Project\b(?=[^>]*?FileFormat=)[^>]*?BuildNumber="\K[^"]*}{0};
  s{<MoTeCM1BuildSession\b[^>]*?Locale="\K[^"]*}{'"$locale"'};
  s{<LogSetup\b[^>]*?Locale="\K[^"]*}{'"$locale"'};
  s{<Configuration\b[^>]*?Locale="\K[^"]*}{'"$locale"'};
'

changed=""
for file in "$@"; do
  [ -f "$file" ] || continue
  before="$(mktemp)"
  cp "$file" "$before"
  perl -0777 -pi -e "$prog" "$file"
  cmp -s "$before" "$file" || changed="$changed $file"
  rm -f "$before"
done

[ -z "$changed" ] && exit 0

echo "Normalised M1 Build's per-save stamps (build number, locale):"
for file in $changed; do
  echo "    $file"
done
echo
echo "Review the change and stage it, then commit again:"
# shellcheck disable=SC2086
echo "    git add$changed"
exit 1
